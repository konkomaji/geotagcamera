<?xml version="1.0" encoding="utf-8"?>
<!--
  GeoTag Camera adaptive icon background.
  Solid adaptive_icon_bg (#0C0E10), per docs/GeoTag Camera Design System.dc.html
  section 02: the foreground is the mark only with no background artwork, so
  launcher parallax has nothing to smear.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/adaptive_icon_bg" />
</shape>
